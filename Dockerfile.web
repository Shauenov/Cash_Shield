FROM node:22-slim AS build
WORKDIR /web
# package-lock.json is not copied: it was created on Windows and lacks the Linux native
# builds of rollup. package.json pins exact versions of the direct dependencies.
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web/ .
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80
